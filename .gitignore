.env
.env.*
!.env.example
*.pem
*.p8
*.p12
*.key
*.jks
*.mobileprovision

# Logs and temporary files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
*.tmp

# Editors, local tooling and OS files
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
